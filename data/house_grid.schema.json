{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HouseGridBlueprint",
  "type": "object",
  "required": ["version", "dimensions", "entrances", "exits", "named_zones"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"type": "string"},
    "name": {"type": "string"},
    "description": {"type": "string"},
    "dimensions": {
      "type": "object",
      "required": ["rows", "columns", "cell_size_meters"],
      "properties": {
        "rows": {"type": "integer", "minimum": 1},
        "columns": {"type": "integer", "minimum": 1},
        "cell_size_meters": {"type": "number", "minimum": 0.1}
      }
    },
    "entrances": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "row", "col"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "row": {"type": "integer", "minimum": 0},
          "col": {"type": "integer", "minimum": 0}
        }
      }
    },
    "exits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "row", "col"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "row": {"type": "integer", "minimum": 0},
          "col": {"type": "integer", "minimum": 0}
        }
      }
    },
    "named_zones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "cells"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "color": {"type": "string"},
          "cells": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["row", "col"],
              "properties": {
                "row": {"type": "integer", "minimum": 0},
                "col": {"type": "integer", "minimum": 0}
              }
            }
          }
        }
      }
    },
    "walls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": {
            "type": "object",
            "required": ["row", "col"],
            "properties": {
              "row": {"type": "integer"},
              "col": {"type": "integer"}
            }
          },
          "to": {
            "type": "object",
            "required": ["row", "col"],
            "properties": {
              "row": {"type": "integer"},
              "col": {"type": "integer"}
            }
          }
        }
      }
    }
  }
}
